{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20,
        "excludedTypes": "Exception"
      }
    },
    "LogLevel": {
      "default": "Information",
      "Host.Triggers": "Warning",
      "Host.Triggers.ServiceBus": "Warning",
      "Host.Results": "Warning",
      "Function": "Information",
      "Azure": "Warning",
      "Azure.Core": "Warning",
      "Azure.Storage.Blobs": "Error",
      "Azure.Messaging.ServiceBus": "Error",
      "Microsoft": "Warning",
      "Microsoft.Azure.WebJobs": "Warning",
      "Microsoft.Azure.WebJobs.ServiceBus": "Warning",
      "Microsoft.Azure.WebJobs.Script": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "serviceBus": {
      "prefetchCount": 130,
      "messageHandlerOptions": {
        "maxConcurrentCalls": 32
      },
      "batchOptions": {
        "maxMessageCount": 130,
        "operationTimeout": "00:00:01",
        "autoComplete": false
      }
    }
  }
}